# ─────────────────────────────────────────────────────────────
# 네이버 뉴스 검색 (선택 — 없으면 구글 뉴스만 수집합니다)
# https://console.ncloud.com/naver-api-hub/application 에서
# 애플리케이션을 등록하고 "검색" API를 추가하면 발급됩니다.
# (구 developers.naver.com 키도 그대로 동작합니다)
# ─────────────────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 일일 호출 한도 (기본 25,000). 이 수를 넘으면 네이버 호출을 자동으로 차단하고
# 화면에 "오늘 네이버 무료 호출을 다 썼습니다" 안내를 띄웁니다.
# 카운터는 .data/naver-quota.json 에 저장되며 한국 시간 자정에 초기화됩니다.
NAVER_DAILY_LIMIT=25000

# ─────────────────────────────────────────────────────────────
# AI 요약 (선택 — 없으면 추출식 요약으로 자동 대체됩니다)
# https://console.anthropic.com 에서 발급
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# 메일 발송 (선택 — 없으면 "메일 보내기" 시 안내 메시지가 뜹니다)
# 예) Gmail: smtp.gmail.com / 587 / 앱 비밀번호 사용
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
